{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/cairo/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["react", "react-*", "@supabase/*", "@capacitor/*", "**/lib/*", "../lib/*", "../../lib/*", "**/components/*", "**/pages/*", "**/movel/*"],
            "message": "O núcleo do Cairo (src/cairo) é puro: não importa React, Supabase, Capacitor nem src/lib. Quem liga o app ao Cairo é src/lib/cairo.ts."
          }]
        }]
      }
    }
  ]
}
